{
  "name": "les-echos-d-aldara",
  "private": true,
  "version": "0.1.0",
  "description": "RPG 2D en pixel art inspiré des RPG Game Boy Advance",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:assets",
    "build": "npm run build:assets && tsc --noEmit && vite build",
    "build:assets": "node scripts/build-art.mjs && node scripts/build-maps.mjs",
    "build:art": "node scripts/build-art.mjs",
    "build:maps": "node scripts/build-maps.mjs",
    "validate": "node scripts/validate-data.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
