    { "perso": "aubin", "expr": "colere", "texte": "Kaël, reste en arrière. C’est moi qu’ils veulent." },
    {
      "perso": "ilse",
      "texte": "Aubin de Brumeval. Dernier gardien de la lignée de Terre. Le Maître vous salue."
    },
    {
      "perso": "aubin",
      "texte": "Dis à ton maître qu’il peut venir me saluer lui-même. Et repartir les mains vides."
    },
    {
      "perso": "corvo",
      "expr": "sourire",
      "texte": "Oh, il me plaît, le vieux ! Je peux le taper, Ilse ? Je peux ?"
