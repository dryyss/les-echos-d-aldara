    { "type": "spawn", "pnj": "corvo", "sprite": "corvo", "x": 16, "y": 10, "direction": "down" },
    {
      "perso": "bertrand",
      "expr": "colere",
      "texte": "Qui êtes-vous ?! On n’a rien, ici ! Que du blé et de la tourte !"
    },
    { "type": "move", "cible": "ilse", "direction": "down", "pas": 1 },
    { "type": "move", "cible": "corvo", "direction": "down", "pas": 1 },
    {
      "perso": "ilse",
      "texte": "Nous cherchons le gardien de la Clé de Terre. Vous avez une minute pour nous le livrer."
    },
    {
      "perso": "corvo",
      "expr": "sourire",
      "texte": "Ou deux ! Moi je suis patient. Enfin, pas trop. Ha !"
    },
    {
      "perso": "margot",
      "expr": "surpris",
      "texte": "Une clé ? Quelle clé ? On n’a même pas de serrure à l’église !"
